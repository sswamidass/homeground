<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  {{ content_for_header }}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#1a2e1a">
  <title>{{ shop.name }}{% if page_title %} — {{ page_title }}{% endif %}</title>
  <meta name="description" content="{{ shop.description | default: 'Something new is coming.' | escape }}">
  <meta name="robots" content="noindex,nofollow">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Jost:wght@300;400;500&display=swap"
    rel="stylesheet"
  >

  {{ 'password-page.css' | asset_url | stylesheet_tag }}
</head>

<body>

  <!-- Full-bleed background photo -->
  <div class="pg-bg" aria-hidden="true">
    <img
      class="pg-bg-img"
      src="{{ 'fall.jpeg' | asset_url }}"
      alt=""
      fetchpriority="high"
    >
  </div>

  <div class="pg-shell">

    <!-- ── Default state ───────────────────────────────────────── -->
    <div class="pg-default-state" id="pg-default-state" {%- if form.posted_successfully? %} style="display:none"{% endif %}>

      <main id="MainContent" class="pg-main" role="main">
        <h1 class="pg-headline" aria-label="Something New is Coming">
          <span class="line-normal">Something</span>
          <span class="line-italic">New</span>
          <span class="line-normal">is Coming</span>
        </h1>
      </main>

      <div class="pg-bottom">

        <p class="pg-sub">
          A monthly box of exceptional coffee &amp; books, curated for the curious.
          Be the first to know when we open.
        </p>

        <div class="pg-form-wrap">
          {%- form 'customer', id: 'pg-signup-form', class: 'pg-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,waitlist">

            <div class="pg-input-row" role="group" aria-label="Email signup">
              <label for="pg-email" class="visually-hidden">Email address</label>
              <input
                type="email"
                name="contact[email]"
                id="pg-email"
                class="pg-email-input"
                placeholder="your@email.com"
                autocomplete="email"
                spellcheck="false"
                required
                aria-required="true"
              >
              <button
                type="submit"
                class="pg-btn"
                aria-label="Join the waitlist"
              >
                <span class="btn-label">Notify Me</span>
                <span class="btn-loading" aria-hidden="true">
                  <span class="pg-spinner"></span>
                </span>
                <span class="btn-done" aria-hidden="true">✓</span>
              </button>
            </div>

            <div id="pg-msg" aria-live="polite" aria-atomic="true">
              {%- if form.errors -%}
                <p class="pg-error-msg">
                  {{ form.errors.messages['email'] | default: 'Something went wrong — please try again.' }}
                </p>
              {%- endif -%}
            </div>
          {%- endform -%}
        </div>

        <div class="pg-brand">
          <img
            src="{{ 'logo.png' | asset_url }}"
            alt="{{ shop.name }}"
            class="pg-brand-logo"
            width="5695"
            height="857"
          >
          <p class="pg-brand-handle">@homeground_box</p>
        </div>

        <button
          type="button"
          class="pg-admin-btn"
          id="pg-access-trigger"
          aria-haspopup="dialog"
          aria-controls="pg-access-overlay"
        >
          Enter store
        </button>

      </div><!-- /.pg-bottom -->

    </div><!-- /.pg-default-state -->

    <!-- ── Success state ────────────────────────────────────────── -->
    <div class="pg-success-state{%- if form.posted_successfully? %} pg-state--in{% endif %}" id="pg-success-state" aria-live="polite">
      <div class="pg-success-inner">
        <p class="pg-success-eyebrow">You're on the list</p>
        <h2 class="pg-success-heading">
          <span class="line-italic">Thanks for</span>
          <span class="line-normal">subscribing</span>
        </h2>
        <p class="pg-success-body">
          We're excited to share what we have in store.
        </p>
      </div>

      <div class="pg-brand">
        <img
          src="{{ 'logo.png' | asset_url }}"
          alt="{{ shop.name }}"
          class="pg-brand-logo"
          width="5695"
          height="857"
        >
        <p class="pg-brand-handle">@homeground_box</p>
      </div>
    </div><!-- /.pg-success-state -->

  </div><!-- /.pg-shell -->

  <!-- Hidden theme slot -->
  <div class="pg-hidden" aria-hidden="true">{{ content_for_layout }}</div>

  <!-- ── Store password overlay (admin access) ────────────────── -->
  <div
    class="pg-overlay"
    id="pg-access-overlay"
    role="dialog"
    aria-modal="true"
    aria-labelledby="pg-overlay-heading"
  >
    <div class="pg-overlay-inner">
      <button
        type="button"
        class="pg-overlay-close"
        id="pg-overlay-close"
        aria-label="Close"
      >×</button>

      <h2 id="pg-overlay-heading" class="pg-overlay-heading">Enter store</h2>

      {%- form 'storefront_password' -%}
        <div class="pg-input-row">
          <label for="pg-store-pass" class="visually-hidden">Store password</label>
          <input
            type="password"
            name="password"
            id="pg-store-pass"
            class="pg-email-input"
            placeholder="Store password"
            autocomplete="current-password"
            {% if form.errors %}aria-invalid="true"{% endif %}
          >
          <button type="submit" class="pg-btn">
            <span class="btn-label">Enter</span>
          </button>
        </div>
        {%- if form.errors -%}
          <p class="pg-error-msg">Incorrect password. Please try again.</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>

  <script>
    // ── Store access overlay ─────────────────────────────────────
    var trigger  = document.getElementById('pg-access-trigger');
    var overlay  = document.getElementById('pg-access-overlay');
    var closeBtn = document.getElementById('pg-overlay-close');

    function openOverlay() {
      overlay.classList.add('is-open');
      var inp = overlay.querySelector('input');
      if (inp) inp.focus();
    }

    function closeOverlay() {
      overlay.classList.remove('is-open');
      trigger.focus();
    }

    trigger.addEventListener('click', openOverlay);
    closeBtn.addEventListener('click', closeOverlay);

    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) closeOverlay();
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && overlay.classList.contains('is-open')) closeOverlay();
    });

    // Auto-open if store password errored (page reloaded after wrong password)
    {%- if form.errors -%}
    openOverlay();
    {%- endif -%}

    // ── Async email signup ───────────────────────────────────────
    var signupForm    = document.getElementById('pg-signup-form');
    var defaultState  = document.getElementById('pg-default-state');
    var successState  = document.getElementById('pg-success-state');

    function showSuccess() {
      defaultState.classList.add('pg-state--out');
      setTimeout(function() {
        defaultState.style.display = 'none';
        successState.classList.add('pg-state--in');
      }, 400);
    }

    if (signupForm) {
      signupForm.addEventListener('submit', function(e) {
        e.preventDefault();

        var emailInput = signupForm.querySelector('#pg-email');
        var btn        = signupForm.querySelector('.pg-btn');
        var msgEl      = document.getElementById('pg-msg');
        var email      = emailInput.value.trim();

        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
          emailInput.focus();
          emailInput.setCustomValidity('Please enter a valid email address.');
          emailInput.reportValidity();
          return;
        }
        emailInput.setCustomValidity('');

        btn.setAttribute('data-state', 'loading');
        btn.disabled = true;
        emailInput.disabled = true;

        fetch('/contact', {
          method: 'POST',
          body: new FormData(signupForm),
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(function(res) {
          if (res.ok) {
            btn.setAttribute('data-state', 'done');
            setTimeout(showSuccess, 700);
          } else {
            throw new Error('error');
          }
        })
        .catch(function() {
          btn.removeAttribute('data-state');
          btn.disabled = false;
          emailInput.disabled = false;
          msgEl.innerHTML =
            '<p class="pg-error-msg" role="alert">Something went wrong \u2014 please try again.</p>';
        });
      });
    }
  </script>

</body>
</html>
